@model List<TechStoreMVC.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<p>Quantidade de Categorias: <span>@Model.Count</span></p>

<h1>
    Lista de Categorias
</h1>

<table class="table table-striped">

    <thead>
        <tr>
            <th scope="col">Código</th>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Situação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nome</td>
                <td>@categoria.Descricao</td>
                <td style="color: @(categoria.Ativa ? "green" : "red")">
                    @(categoria.Ativa ? "Ativa" : "Inativa")
                </td>
            </tr>
        }
    </tbody>

</table>